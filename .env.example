# Firebase Client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Emulator (set to "true" for local development)
NEXT_PUBLIC_FIREBASE_EMULATOR=true

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Veřejná URL formuláře podkladů na webu (včetně ?token=)
NEXT_PUBLIC_CARD_FORM_BASE_URL=https://www.solopixel.cz/cs/vizitka-formular?token=

# Resend (e-mailové oslovení)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Sdílené tajemství pro interní upozornění na vyplněný podklad (musí sedět s webem)
SUBMISSION_NOTIFY_SECRET=

# Sdílené tajemství pro příjem webových poptávek (POST /api/leads/intake, musí sedět s webem)
WEB_LEAD_INGEST_SECRET=
# UID výchozího vlastníka, kterému se přiřadí leady přišlé z webu (Firebase Auth UID)
LEADS_DEFAULT_OWNER_UID=

# Bankovní účet do těla faktury e-mailem (volitelné, do fáze Fakturoid).
# Bez hodnoty se řádek s číslem účtu v e-mailu nezobrazí.
COMPANY_BANK_ACCOUNT=

# Fakturoid API v3 (účetní pravda + PDF + stav platby z ČSOB).
# Bez těchto hodnot je integrace neaktivní (faktury zůstávají jen v CRM).
FAKTUROID_SLUG=
FAKTUROID_CLIENT_ID=
FAKTUROID_CLIENT_SECRET=
# User-Agent musí obsahovat kontaktní e-mail (požadavek Fakturoidu).
FAKTUROID_USER_AGENT=SPX Core (apps@solopixel.cz)

# Tajemství pro zabezpečení fakturačního cronu (Vercel Cron posílá Bearer).
CRON_SECRET=
# Kill-switch fakturačního cronu — generuje faktury jen když je "true".
# Nech prázdné/false, dokud nechceš spustit automatické fakturování.
BILLING_CRON_ENABLED=

# Web Push (VAPID) — vygeneruj: npx web-push generate-vapid-keys
# Public klíč vidí i klient (subscribe), private zůstává na serveru.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt pro push službu (mailto:), default hello@solopixel.cz
VAPID_SUBJECT=mailto:hello@solopixel.cz
