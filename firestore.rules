rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is user a team member? Auth je sdílený s klientskou zónou
    // (spx-hub, role 'client') — ta ani účty bez role sem nesmí nic.
    function isTeam() {
      return request.auth != null
        && request.auth.token.get('role', '') in ['admin', 'member', 'sales'];
    }

    // Helper: is user admin?
    function isAdmin() {
      return isTeam() && request.auth.token.role == 'admin';
    }

    // Helper: is user admin or member (not sales)?
    function isAdminOrMember() {
      return isTeam() && request.auth.token.role in ['admin', 'member'];
    }

    // Users — read for team, write for admin only
    match /users/{userId} {
      allow read: if isTeam();
      allow write: if isAdmin();

      // Push odběry — zapisují/čtou se jen přes admin SDK (route handlers).
      match /pushSubscriptions/{subId} {
        allow read, write: if false;
      }
    }

    // Notifikace — příjemce čte jen svoje a smí měnit jen `readAt`.
    // Vytváří/maže je admin SDK (notify()).
    match /notifications/{notifId} {
      allow read: if isTeam() && resource.data.recipientUid == request.auth.uid;
      allow update: if isTeam()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow create, delete: if false;
    }

    // Clients — admin/member reads all; sales reads only own (salesOwnerUid == uid)
    match /clients/{clientId} {
      allow read: if isTeam() && (isAdminOrMember() || resource.data.salesOwnerUid == request.auth.uid);
      allow write: if false;
    }

    // Instances — read for team, write denied (opens in later phases)
    match /instances/{instanceId} {
      allow read: if isTeam();
      allow write: if false;
    }

    // Projects — jednorázové zakázky klienta; read for team, write via admin SDK
    match /projects/{projectId} {
      allow read: if isTeam();
      allow write: if false;
    }

    // Domains — vlastní domény klienta; read for team, write via admin SDK
    match /domains/{domainId} {
      allow read: if isTeam();
      allow write: if false;
    }

    // Leads — zrušené (2026-09-30), data zůstávají jen ke čtení; poptávky z webu jdou do prospects
    match /leads/{leadId} {
      allow read: if isTeam();
      allow write: if false;
    }

    // Subscriptions — read for admin/member only (not sales)
    match /subscriptions/{subId} {
      allow read: if isAdminOrMember();
      allow write: if false;
    }

    // Invoices — read for admin/member only (not sales)
    match /invoices/{invoiceId} {
      allow read: if isAdminOrMember();
      allow write: if false;
    }

    // Tasks — read for team, status update for team
    match /tasks/{taskId} {
      allow read: if isTeam();
      allow update: if isTeam() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow create, delete: if false;
    }

    // Tickets — read for team, create/update for team
    match /tickets/{ticketId} {
      allow read: if isTeam();
      allow create, update: if isTeam();
      allow delete: if false;
    }

    // Templates — read for team, write for admin
    match /templates/{templateId} {
      allow read: if isTeam();
      allow write: if isAdmin();
    }

    // Email marketing templates — vlastní HTML šablony; read for team,
    // write via admin SDK (route handlers, jen admin/member)
    match /emailTemplates/{templateId} {
      allow read: if isTeam();
      allow write: if false;
    }

    // Marketing seznamy kontaktů — read for team, write via admin SDK
    match /marketingLists/{listId} {
      allow read: if isTeam();
      allow write: if false;
    }

    // Marketingové kampaně + jejich e-maily — read for team, write via admin SDK
    match /campaigns/{campaignId} {
      allow read: if isTeam();
      allow write: if false;
    }
    match /campaignEmails/{emailId} {
      allow read: if isTeam();
      allow write: if false;
    }

    // Odhlášení z marketingu — zápis přes admin SDK (veřejná unsubscribe route)
    match /marketingUnsubscribes/{email} {
      allow read: if isTeam();
      allow write: if false;
    }

    // Prospects — read for team, write via admin SDK (route handlers)
    match /prospects/{prospectId} {
      allow read: if isTeam();
      allow write: if false;
    }

    // Prospect categories — číselník kategorií kontaktů; read for team,
    // write via admin SDK (route handlers)
    match /prospectCategories/{categoryId} {
      allow read: if isTeam();
      allow write: if false;
    }

    // Activity — read for team, append-only (no update/delete)
    match /activity/{activityId} {
      allow read: if isTeam();
      allow create: if isTeam();
      allow update, delete: if false;
    }

    // Commissions — sales reads own, admin/member reads all, write via admin SDK
    match /commissions/{commId} {
      allow read: if isTeam() && (isAdminOrMember() || resource.data.salesUid == request.auth.uid);
      allow write: if false;
    }

    // Settings — read for team, write for admin
    match /settings/{settingId} {
      allow read: if isTeam();
      allow write: if isAdmin();
    }

    // Outreach emails — read for team, write via admin SDK
    match /outreachEmails/{emailId} {
      allow read: if isTeam();
      allow write: if false;
    }

    // Delivery emails — read for team, write via admin SDK
    match /deliveryEmails/{emailId} {
      allow read: if isTeam();
      allow write: if false;
    }

    // Invoice emails — read for team, write via admin SDK
    match /invoiceEmails/{emailId} {
      allow read: if isTeam();
      allow write: if false;
    }

    // Counters — admin only
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // Card tokens — public get (token is secret in URL), no public list.
    // Public update ONLY to mark the token used after form submit: just the
    // key 'usedAt' may change (identity fields name/email/clientId stay locked),
    // the token must not be used yet (no double submit), and usedAt must be the
    // server timestamp. Create/delete via admin SDK only.
    match /card-tokens/{token} {
      allow get: if true;
      allow list: if isTeam();
      allow update: if resource.data.get('usedAt', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedAt'])
        && request.resource.data.usedAt == request.time;
      allow create, delete: if false;
    }

    // Card submissions — public create from web form (schemaVersion 2, vnořený
    // tvar: identita je v `basic`), read via admin SDK. Starší ploché záznamy
    // už nevznikají (nový formulář zapisuje jen v2).
    match /card-submissions/{token} {
      allow create: if request.resource.data.schemaVersion == 2
        && request.resource.data.keys().hasAll(['token', 'basic', 'createdAt'])
        && request.resource.data.token is string
        && request.resource.data.basic is map
        && request.resource.data.basic.fullName is string
        && request.resource.data.basic.fullName.size() > 0
        && request.resource.data.basic.fullName.size() < 200
        && request.resource.data.basic.email is string
        && request.resource.data.basic.email.size() > 0;
      allow read: if isTeam();
      allow update, delete: if false;
    }

    // Reference v klientské zóně (spx-hub): projekty referencí vizitek, samotné
    // reference a audit. Čte i zapisuje výhradně spx-hub přes Admin SDK (veřejný
    // formulář i správa jdou přes jeho route handlery), klientský SDK nic.
    match /hubProjects/{slug} {
      allow read, write: if false;
    }
    match /hubReferences/{referenceId} {
      allow read, write: if false;
    }
    match /hubAuditLog/{entryId} {
      allow read, write: if false;
    }
  }
}
