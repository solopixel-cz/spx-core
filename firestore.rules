rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is user authenticated?
    function isAuth() {
      return request.auth != null;
    }

    // Helper: is user admin?
    function isAdmin() {
      return isAuth() && request.auth.token.role == 'admin';
    }

    // Helper: is user admin or member (not sales)?
    function isAdminOrMember() {
      return isAuth() && request.auth.token.role in ['admin', 'member'];
    }

    // Users — read for authenticated, write for admin only
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Clients — admin/member reads all; sales reads only own (salesOwnerUid == uid)
    match /clients/{clientId} {
      allow read: if isAuth() && (isAdminOrMember() || resource.data.salesOwnerUid == request.auth.uid);
      allow write: if false;
    }

    // Instances — read for authenticated, write denied (opens in later phases)
    match /instances/{instanceId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Leads — read for authenticated, stage update for authenticated (drag&drop)
    match /leads/{leadId} {
      allow read: if isAuth();
      allow update: if isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stage', 'updatedAt']);
      allow create, delete: if false;
    }

    // Subscriptions — read for admin/member only (not sales)
    match /subscriptions/{subId} {
      allow read: if isAdminOrMember();
      allow write: if false;
    }

    // Invoices — read for admin/member only (not sales)
    match /invoices/{invoiceId} {
      allow read: if isAdminOrMember();
      allow write: if false;
    }

    // Tasks — read for authenticated, status update for authenticated
    match /tasks/{taskId} {
      allow read: if isAuth();
      allow update: if isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow create, delete: if false;
    }

    // Tickets — read for authenticated, create/update for authenticated
    match /tickets/{ticketId} {
      allow read: if isAuth();
      allow create, update: if isAuth();
      allow delete: if false;
    }

    // Templates — read for authenticated, write for admin
    match /templates/{templateId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Prospects — read for authenticated, write via admin SDK (route handlers)
    match /prospects/{prospectId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Activity — read for authenticated, append-only (no update/delete)
    match /activity/{activityId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // Commissions — sales reads own, admin/member reads all, write via admin SDK
    match /commissions/{commId} {
      allow read: if isAuth() && (isAdminOrMember() || resource.data.salesUid == request.auth.uid);
      allow write: if false;
    }

    // Settings — read for authenticated, write for admin
    match /settings/{settingId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Outreach emails — read for authenticated, write via admin SDK
    match /outreachEmails/{emailId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Delivery emails — read for authenticated, write via admin SDK
    match /deliveryEmails/{emailId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Counters — admin only
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // Card tokens — public get (token is secret in URL), no public list.
    // Public update ONLY to mark the token used after form submit: just the
    // key 'usedAt' may change (identity fields name/email/clientId stay locked),
    // the token must not be used yet (no double submit), and usedAt must be the
    // server timestamp. Create/delete via admin SDK only.
    match /card-tokens/{token} {
      allow get: if true;
      allow list: if isAuth();
      allow update: if resource.data.get('usedAt', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedAt'])
        && request.resource.data.usedAt == request.time;
      allow create, delete: if false;
    }

    // Card submissions — public create from web form (schemaVersion 2, vnořený
    // tvar: identita je v `basic`), read via admin SDK. Starší ploché záznamy
    // už nevznikají (nový formulář zapisuje jen v2).
    match /card-submissions/{token} {
      allow create: if request.resource.data.schemaVersion == 2
        && request.resource.data.keys().hasAll(['token', 'basic', 'createdAt'])
        && request.resource.data.token is string
        && request.resource.data.basic is map
        && request.resource.data.basic.fullName is string
        && request.resource.data.basic.fullName.size() > 0
        && request.resource.data.basic.fullName.size() < 200
        && request.resource.data.basic.email is string
        && request.resource.data.basic.email.size() > 0;
      allow read: if isAuth();
      allow update, delete: if false;
    }
  }
}
