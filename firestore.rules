rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is user authenticated?
    function isAuth() {
      return request.auth != null;
    }

    // Helper: is user admin?
    function isAdmin() {
      return isAuth() && request.auth.token.role == 'admin';
    }

    // Helper: má uživatel platnou roli (admin/user)?
    // Účet bez přiřazené role nemá přístup. 'member'/'sales' jsou ponechány
    // přechodně kvůli starším claimům — po migraci uživatelů je lze odebrat.
    function isStaff() {
      return isAuth() && request.auth.token.role in ['admin', 'user', 'member', 'sales'];
    }

    // Users — read for staff, write for admin only
    match /users/{userId} {
      allow read: if isStaff();
      allow write: if isAdmin();

      // Push odběry — zapisují/čtou se jen přes admin SDK (route handlers).
      match /pushSubscriptions/{subId} {
        allow read, write: if false;
      }
    }

    // Notifikace — příjemce čte jen svoje a smí měnit jen `readAt`.
    // Vytváří/maže je admin SDK (notify()).
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.recipientUid == request.auth.uid;
      allow update: if isAuth()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow create, delete: if false;
    }

    // Clients — čtou všichni se platnou rolí; zápis přes admin SDK
    match /clients/{clientId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Instances — read for staff, write via admin SDK
    match /instances/{instanceId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Domains — vlastní domény klienta; read for staff, write via admin SDK
    match /domains/{domainId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Leads — read for staff, stage update for staff (drag&drop)
    match /leads/{leadId} {
      allow read: if isStaff();
      allow update: if isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stage', 'updatedAt']);
      allow create, delete: if false;
    }

    // Subscriptions — finance: jen admin
    match /subscriptions/{subId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Invoices — finance: jen admin
    match /invoices/{invoiceId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Tasks — read for staff, status update for staff
    match /tasks/{taskId} {
      allow read: if isStaff();
      allow update: if isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow create, delete: if false;
    }

    // Tickets — read for staff, create/update for staff
    match /tickets/{ticketId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if false;
    }

    // Templates — read for staff, write for admin
    match /templates/{templateId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Prospects — read for staff, write via admin SDK (route handlers)
    match /prospects/{prospectId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Activity — read for staff, append-only (no update/delete)
    match /activity/{activityId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // Commissions — finance: jen admin
    match /commissions/{commId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Settings — read for staff, write for admin
    match /settings/{settingId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Outreach emails — read for staff, write via admin SDK
    match /outreachEmails/{emailId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Delivery emails — read for staff, write via admin SDK
    match /deliveryEmails/{emailId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Invoice emails — finance: jen admin
    match /invoiceEmails/{emailId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Counters — admin only
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // Card tokens — public get (token is secret in URL), no public list.
    // Public update ONLY to mark the token used after form submit: just the
    // key 'usedAt' may change (identity fields name/email/clientId stay locked),
    // the token must not be used yet (no double submit), and usedAt must be the
    // server timestamp. Create/delete via admin SDK only.
    match /card-tokens/{token} {
      allow get: if true;
      allow list: if isStaff();
      allow update: if resource.data.get('usedAt', null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedAt'])
        && request.resource.data.usedAt == request.time;
      allow create, delete: if false;
    }

    // Card submissions — public create from web form (schemaVersion 2, vnořený
    // tvar: identita je v `basic`), read via admin SDK. Starší ploché záznamy
    // už nevznikají (nový formulář zapisuje jen v2).
    match /card-submissions/{token} {
      allow create: if request.resource.data.schemaVersion == 2
        && request.resource.data.keys().hasAll(['token', 'basic', 'createdAt'])
        && request.resource.data.token is string
        && request.resource.data.basic is map
        && request.resource.data.basic.fullName is string
        && request.resource.data.basic.fullName.size() > 0
        && request.resource.data.basic.fullName.size() < 200
        && request.resource.data.basic.email is string
        && request.resource.data.basic.email.size() > 0;
      allow read: if isStaff();
      allow update, delete: if false;
    }
  }
}
