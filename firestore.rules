rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is user authenticated?
    function isAuth() {
      return request.auth != null;
    }

    // Helper: is user admin?
    function isAdmin() {
      return isAuth() && request.auth.token.role == 'admin';
    }

    // Helper: is user admin or member (not sales)?
    function isAdminOrMember() {
      return isAuth() && request.auth.token.role in ['admin', 'member'];
    }

    // Users — read for authenticated, write for admin only
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Clients — read for authenticated, write via admin SDK (deny client write for now)
    match /clients/{clientId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Instances — read for authenticated, write denied (opens in later phases)
    match /instances/{instanceId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Leads — read for authenticated, stage update for authenticated (drag&drop)
    match /leads/{leadId} {
      allow read: if isAuth();
      allow update: if isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stage', 'updatedAt']);
      allow create, delete: if false;
    }

    // Subscriptions — read for admin/member only (not sales)
    match /subscriptions/{subId} {
      allow read: if isAdminOrMember();
      allow write: if false;
    }

    // Invoices — read for admin/member only (not sales)
    match /invoices/{invoiceId} {
      allow read: if isAdminOrMember();
      allow write: if false;
    }

    // Tasks — read for authenticated, status update for authenticated
    match /tasks/{taskId} {
      allow read: if isAuth();
      allow update: if isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow create, delete: if false;
    }

    // Tickets — read for authenticated, create/update for authenticated
    match /tickets/{ticketId} {
      allow read: if isAuth();
      allow create, update: if isAuth();
      allow delete: if false;
    }

    // Templates — read for authenticated, write for admin
    match /templates/{templateId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Prospects — read for authenticated, write via admin SDK (route handlers)
    match /prospects/{prospectId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Activity — read for authenticated, append-only (no update/delete)
    match /activity/{activityId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // Counters — admin only
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // Card tokens — public get (token is secret in URL), no list, write via admin SDK
    match /card-tokens/{token} {
      allow get: if true;
      allow list: if isAuth();
      allow create, update, delete: if false;
    }

    // Card submissions — public create (from web form), read via admin SDK
    match /card-submissions/{token} {
      allow create: if true
        && request.resource.data.keys().hasAll(['fullName', 'email', 'token', 'createdAt'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() < 200
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.token is string;
      allow read: if isAuth();
      allow update, delete: if false;
    }
  }
}
