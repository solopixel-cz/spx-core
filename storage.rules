rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Jen tým — klientská zóna (spx-hub, role 'client') sdílí Auth.
    function isTeam() {
      return request.auth != null
        && request.auth.token.get('role', '') in ['admin', 'member', 'sales'];
    }

    // Ticket attachments — team only, max 10 MB, images and PDFs only
    match /tickets/{ticketId}/{fileName} {
      allow read: if isTeam();
      allow write: if isTeam()
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
    }

    // Card profile images — public read (used on live card), public write (form upload), max 5 MB, images only
    match /cards/{token}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // User avatars — own uid only, max 2 MB, images only
    match /avatars/{fileName} {
      allow read: if isTeam();
      allow write: if isTeam()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Default: read for team, write denied
    match /{allPaths=**} {
      allow read: if isTeam();
      allow write: if false;
    }
  }
}
